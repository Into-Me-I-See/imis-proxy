{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/install/index.html" },
    { "source": "/install", "destination": "/install/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/sw.js", "destination": "/sw.js" }
  ],
  "headers": [
    {
      "source": "/app/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-src https://app.into-me-i-see.ca; script-src 'self' 'unsafe-inline' https://app.into-me-i-see.ca; style-src 'self' 'unsafe-inline' https://app.into-me-i-see.ca; img-src * data: blob:; connect-src *; media-src *; font-src *; worker-src 'self' blob:;"
        }
      ]
    }
  ]
}
